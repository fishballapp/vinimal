{
  "name": "@vinimal/extension",
  "version": "0.3.1",
  "private": true,
  "license": "GPL-3.0-only",
  "type": "module",
  "exports": {
    "./polar-config": "./src/licence/polar-config.ts",
    "./polar": "./src/licence/polar.ts",
    "./keys/commands": "./src/keys/commands.ts",
    "./keys/dispatch": "./src/keys/dispatch.ts",
    "./keys/platform": "./src/keys/platform.ts",
    "./keys/text-field": "./src/keys/text-field.ts",
    "./scroll/glide": "./src/scroll/glide.ts",
    "./scroll/scroller": "./src/scroll/scroller.ts",
    "./hints/activate": "./src/hints/activate.ts",
    "./hints/labels": "./src/hints/labels.ts",
    "./hints/targets": "./src/hints/targets.ts",
    "./ui/overlay/hint-layer": "./src/ui/overlay/hint-layer.ts",
    "./ui/overlay/toast": "./src/ui/overlay/toast.ts",
    "./ui/overlay/overlay.css": "./src/ui/overlay/overlay.css",
    "./licence/stopped": "./src/licence/stopped.ts",
    "./site": "./src/site.ts",
    "./site-messages": "./src/site-messages.ts"
  },
  "description": "Vinimal: a Chrome (MV3) extension with the few Vimium keys people use, made to look good.",
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build",
    "build:local": "vite build && mkdir -p ~/.chrome-extensions-dev/vinimal && rsync -a --delete dist/ ~/.chrome-extensions-dev/vinimal/",
    "build:release": "vite build --mode release",
    "zip": "pnpm build:release && node scripts/zip.ts",
    "icons": "node scripts/build-icons.ts",
    "test": "vitest run",
    "check:effect": "effect-tsgo diagnostics --project tsconfig.json --format text"
  },
  "dependencies": {
    "@fishballapps/extension-licence": "workspace:*",
    "@fishballapps/utils": "workspace:*",
    "cn": "catalog:",
    "effect": "catalog:",
    "react": "catalog:web",
    "react-dom": "catalog:web"
  },
  "devDependencies": {
    "@fishballapps/vite-plugins": "workspace:*",
    "@tailwindcss/vite": "catalog:",
    "@types/chrome": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:web",
    "@types/react-dom": "catalog:web",
    "@vitejs/plugin-react": "catalog:",
    "sharp": "catalog:",
    "tailwindcss": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
